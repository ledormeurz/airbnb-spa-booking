# ============================================================
# Airbnb Spa Booking — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# The .env file is gitignored — do not commit real secrets.
# ============================================================

# --- PostgreSQL ---
# Database name for the Airbnb Spa application
POSTGRES_DB=airbnb_spa

# Database user
POSTGRES_USER=airbnb

# Database password — CHANGE THIS to a strong random password in production
POSTGRES_PASSWORD=your_secure_password_here

# --- Spring Boot ---
# JDBC connection URL (points to the 'postgres' Docker service on the app-network)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/airbnb_spa

# Database username used by the Spring Boot application (must match POSTGRES_USER)
SPRING_DATASOURCE_USERNAME=airbnb

# Database password used by the Spring Boot application (must match POSTGRES_PASSWORD)
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# Spring profile: 'dev' for development with verbose logging and H2 console,
# 'prod' for production with optimised settings and reduced logging
SPRING_PROFILES_ACTIVE=dev

# --- Admin Demo Account ---
# Default admin username (used at first startup to seed the admin user in the database)
ADMIN_USERNAME=admin

# Default admin password — CHANGE THIS in production to a strong password
ADMIN_PASSWORD=admin123

# --- JWT (access token) ---
# Secret HS256 (>= 32 caractères). CHANGE THIS in production.
JWT_SECRET=change-me-airbnb-spa-jwt-secret-key-32b
# Durée de validité de l'access token en millisecondes (défaut: 1h)
JWT_EXPIRATION_MS=3600000

# --- Server ---
# Port the Spring Boot backend listens on (inside the container, mapped to 8080 on the host)
SERVER_PORT=8080
